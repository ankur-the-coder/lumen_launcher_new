<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <com.example.tvlauncher.AmbientView
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_logo" />

    <LinearLayout
        android:id="@+id/topRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/usbBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/wifi"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:src="@drawable/ic_wifi_off" />

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/leftBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="420dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:shadowColor="#66000000"
            android:shadowDy="3"
            android:shadowRadius="10"
            android:textColor="#FFFFFF"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="2"
            android:textColor="#D8E0EE"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="#B4BDD0"
        android:textSize="15sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="true" />

    <LinearLayout
        android:id="@+id/dockPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/bg_dock"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/dockApps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <View
            android:id="@+id/dockDivider"
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:background="#40FFFFFF" />

        <FrameLayout
            android:id="@+id/btnDrawer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/circle_btn"
            android:focusable="true"
            android:clickable="true"
            android:foreground="@drawable/ring_oval">

            <ImageView
                android:id="@+id/iconDrawer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_apps" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnFiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/circle_btn"
            android:focusable="true"
            android:clickable="true"
            android:foreground="@drawable/ring_oval">

            <ImageView
                android:id="@+id/iconFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_usb" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnInputs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/circle_btn"
            android:focusable="true"
            android:clickable="true"
            android:foreground="@drawable/ring_oval">

            <ImageView
                android:id="@+id/iconInputs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_input" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/circle_btn"
            android:focusable="true"
            android:clickable="true"
            android:foreground="@drawable/ring_oval">

            <ImageView
                android:id="@+id/iconSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_settings" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/dockLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />
</FrameLayout>
